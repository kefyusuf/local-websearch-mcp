# Rate Limiting
RATE_LIMIT_SEARCH_PER_MIN=10
RATE_LIMIT_FETCH_PER_MIN=20

# Search Configuration (comma-separated, tried in order)
SEARCH_PROVIDERS=duckduckgo,bing,brave,google

# Fetch Configuration
FETCH_WAIT_UNTIL=networkidle

# Optional Features
ENABLE_CROSSLINGUAL=false

# Cache Database Path (relative to CWD)
CACHE_DB_PATH=websearch_cache.db
