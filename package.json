{
  "name": "my-websearch-mcp",
  "version": "1.0.0",
  "description": "Offline-first MCP server for web search and content fetching — no API keys required. Uses local AI models for intent classification, cross-lingual search, and semantic re-ranking.",
  "type": "module",
  "keywords": ["mcp", "web-search", "semantic-search", "cross-lingual", "sqlite-vec", "playwright", "transformers.js", "model-context-protocol", "web-scraping", "markdown"],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node build/index.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "npx playwright install chromium",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@mozilla/readability": "^0.6.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.9.0",
    "iconv-lite": "^0.6.3",
    "jsdom": "^24.0.0",
    "playwright": "^1.42.1",
    "sqlite-vec": "^0.1.9",
    "turndown": "^7.1.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^21.1.6",
    "@types/node": "^20.11.24",
    "@types/turndown": "^5.0.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.6"
  }
}
