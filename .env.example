# Rate Limiting
RATE_LIMIT_SEARCH_PER_MIN=10
RATE_LIMIT_FETCH_PER_MIN=20

# Search Configuration (comma-separated, tried in order)
SEARCH_PROVIDERS=duckduckgo,bing

# Fetch Configuration
FETCH_WAIT_UNTIL=domcontentloaded
# Set to 'true' to skip HTTP-first fetch and always use Playwright (useful for debugging JS-rendered pages)
# FORCE_PLAYWRIGHT=true

# Optional Features
ENABLE_CROSSLINGUAL=true
# Ollama integration — use a local LLM for answer extraction instead of regex heuristics
# ENABLE_OLLAMA=true
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Cache Database Path (relative to CWD)
CACHE_DB_PATH=websearch_cache.db

# How often to clean up expired content cache entries (hours, default: 24)
# CACHE_CLEANUP_INTERVAL_HOURS=24
